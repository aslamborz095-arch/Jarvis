# Clé API Claude (console.anthropic.com) — cerveau en ligne. Vide = local uniquement.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Cerveau local (coupure réseau)
OLLAMA_MODEL=qwen2.5:7b
# Code d'accès demandé par l'interface (généré par install.ps1)
JARVIS_TOKEN=
# Validation avant commandes système et écriture de fichiers
CONFIRM_DANGEROUS=true
# Reconnaissance vocale locale : tiny / base / small / medium
WHISPER_MODEL=small
HOST=127.0.0.1
PORT=8765
# Mise à jour automatique depuis GitHub
AUTO_UPDATE=true
JARVIS_REPO=aslamborz095-arch/jarvis
